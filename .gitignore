# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Secrets: never commit real env files or keys
.env
.env.*
!.env.example
*.pem
*.key

# Local Claude Code settings
.claude/settings.local.json

# Build output: the skill zip is attached to every GitHub release
readme-forge.zip
readme-forge-design.zip

# Video production workspace (kept locally, not published)
demo/build/
demo/frames/
demo/*.tape
demo/*.log
demo/STORYBOARD.md
demo/PROMPTS.md
demo/sample-app/README.live.md

# IDEs (e.g. the Java extension) build the test fixtures in place; keep that output out
tests/fixtures/**/build/
tests/fixtures/**/bin/
tests/fixtures/**/obj/
tests/fixtures/**/.gradle/
tests/fixtures/**/target/
